<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_error_event_subprocess_ni"
             targetNamespace="http://sparrow.example/error-event-subprocess-ni">
  <error id="Error_e1" errorCode="E1" name="Error E1"/>
  <process id="Process_error_event_subprocess_ni" name="M5 Error Event SubProcess Non-Interrupting" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_fork</outgoing>
    </startEvent>
    <parallelGateway id="Fork_1">
      <incoming>Flow_start_to_fork</incoming>
      <outgoing>Flow_fork_to_work</outgoing>
      <outgoing>Flow_fork_to_err</outgoing>
    </parallelGateway>
    <userTask id="UserTask_main" name="Main work">
      <incoming>Flow_fork_to_work</incoming>
      <outgoing>Flow_work_to_ok</outgoing>
    </userTask>
    <endEvent id="EndEvent_ok">
      <incoming>Flow_work_to_ok</incoming>
    </endEvent>
    <endEvent id="EndEvent_err">
      <incoming>Flow_fork_to_err</incoming>
      <errorEventDefinition id="ErrorDef_end" errorRef="Error_e1"/>
    </endEvent>
    <sequenceFlow id="Flow_start_to_fork" sourceRef="StartEvent_1" targetRef="Fork_1"/>
    <sequenceFlow id="Flow_fork_to_work" sourceRef="Fork_1" targetRef="UserTask_main"/>
    <sequenceFlow id="Flow_fork_to_err" sourceRef="Fork_1" targetRef="EndEvent_err"/>
    <sequenceFlow id="Flow_work_to_ok" sourceRef="UserTask_main" targetRef="EndEvent_ok"/>

    <subProcess id="Event_SubProcess_1" name="On E1 notify" triggeredByEvent="true">
      <startEvent id="Start_EventSubProcess_1" isInterrupting="false">
        <outgoing>Flow_event_subprocess_start_to_task</outgoing>
        <errorEventDefinition id="ErrorDef_EventSubProcess_1" errorRef="Error_e1"/>
      </startEvent>
      <userTask id="UserTask_EventSubProcess_1" name="Handle error">
        <incoming>Flow_event_subprocess_start_to_task</incoming>
        <outgoing>Flow_event_subprocess_task_to_end</outgoing>
      </userTask>
      <endEvent id="End_EventSubProcess_1">
        <incoming>Flow_event_subprocess_task_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_event_subprocess_start_to_task" sourceRef="Start_EventSubProcess_1" targetRef="UserTask_EventSubProcess_1"/>
      <sequenceFlow id="Flow_event_subprocess_task_to_end" sourceRef="UserTask_EventSubProcess_1" targetRef="End_EventSubProcess_1"/>
    </subProcess>
  </process>
</definitions>
