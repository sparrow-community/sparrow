<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_compensate_esp"
             targetNamespace="http://sparrow.example/compensate-esp">
  <process id="Process_compensate_esp" name="M27 Compensate Event Sub-Process" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_sp</outgoing>
    </startEvent>
    <subProcess id="SubProcess_1" name="Book trip">
      <incoming>Flow_start_to_sp</incoming>
      <outgoing>Flow_sp_to_throw</outgoing>
      <startEvent id="Start_sp">
        <outgoing>Flow_sp_start_to_task</outgoing>
      </startEvent>
      <userTask id="Task_inner" name="Reserve">
        <incoming>Flow_sp_start_to_task</incoming>
        <outgoing>Flow_sp_task_to_end</outgoing>
      </userTask>
      <endEvent id="End_sp">
        <incoming>Flow_sp_task_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_sp_start_to_task" sourceRef="Start_sp" targetRef="Task_inner"/>
      <sequenceFlow id="Flow_sp_task_to_end" sourceRef="Task_inner" targetRef="End_sp"/>
      <subProcess id="Event_SubProcess_Compensate" triggeredByEvent="true">
        <startEvent id="Start_Compensate" isInterrupting="false">
          <outgoing>Flow_esp_start_to_undo</outgoing>
          <compensateEventDefinition id="CompensateStartDef_1"/>
        </startEvent>
        <userTask id="Undo_ESP" name="Cancel trip">
          <incoming>Flow_esp_start_to_undo</incoming>
          <outgoing>Flow_esp_undo_to_end</outgoing>
        </userTask>
        <endEvent id="End_ESP">
          <incoming>Flow_esp_undo_to_end</incoming>
        </endEvent>
        <sequenceFlow id="Flow_esp_start_to_undo" sourceRef="Start_Compensate" targetRef="Undo_ESP"/>
        <sequenceFlow id="Flow_esp_undo_to_end" sourceRef="Undo_ESP" targetRef="End_ESP"/>
      </subProcess>
    </subProcess>
    <intermediateThrowEvent id="CompensateThrow_1">
      <incoming>Flow_sp_to_throw</incoming>
      <outgoing>Flow_throw_to_end</outgoing>
      <compensateEventDefinition id="CompensateThrowDef_1"/>
    </intermediateThrowEvent>
    <endEvent id="End_1">
      <incoming>Flow_throw_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_sp" sourceRef="Start_1" targetRef="SubProcess_1"/>
    <sequenceFlow id="Flow_sp_to_throw" sourceRef="SubProcess_1" targetRef="CompensateThrow_1"/>
    <sequenceFlow id="Flow_throw_to_end" sourceRef="CompensateThrow_1" targetRef="End_1"/>
  </process>
</definitions>
