<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_implicit_throw"
             targetNamespace="http://sparrow.example/implicit-throw">
  <signal id="Signal_1" name="notice.v1"/>
  <process id="Process_implicit_throw" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_task</outgoing>
    </startEvent>
    <userTask id="Task_A">
      <incoming>Flow_start_to_task</incoming>
      <outgoing>Flow_task_to_throw</outgoing>
    </userTask>
    <implicitThrowEvent id="ImplicitThrow_1">
      <incoming>Flow_task_to_throw</incoming>
      <outgoing>Flow_throw_to_end</outgoing>
      <signalEventDefinition id="SignalDef_1" signalRef="Signal_1"/>
    </implicitThrowEvent>
    <endEvent id="End_1">
      <incoming>Flow_throw_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_task" sourceRef="Start_1" targetRef="Task_A"/>
    <sequenceFlow id="Flow_task_to_throw" sourceRef="Task_A" targetRef="ImplicitThrow_1"/>
    <sequenceFlow id="Flow_throw_to_end" sourceRef="ImplicitThrow_1" targetRef="End_1"/>
  </process>
</definitions>
