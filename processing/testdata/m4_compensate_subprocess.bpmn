<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_compensate_subprocess"
             targetNamespace="http://sparrow.example/compensate-subprocess">
  <process id="Process_compensate_subprocess" name="M4 Compensate SubProcess" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_sp</outgoing>
    </startEvent>
    <subProcess id="SubProcess_1" name="Book trip">
      <incoming>Flow_start_to_sp</incoming>
      <outgoing>Flow_sp_to_throw</outgoing>
      <startEvent id="Start_sp">
        <outgoing>Flow_sp_start_to_task</outgoing>
      </startEvent>
      <userTask id="Task_inner" name="Reserve">
        <incoming>Flow_sp_start_to_task</incoming>
        <outgoing>Flow_sp_task_to_end</outgoing>
      </userTask>
      <endEvent id="End_sp">
        <incoming>Flow_sp_task_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_sp_start_to_task" sourceRef="Start_sp" targetRef="Task_inner"/>
      <sequenceFlow id="Flow_sp_task_to_end" sourceRef="Task_inner" targetRef="End_sp"/>
    </subProcess>
    <boundaryEvent id="CompensateBoundary_SP" attachedToRef="SubProcess_1" cancelActivity="false">
      <compensateEventDefinition id="CompensateDef_SP"/>
    </boundaryEvent>
    <userTask id="Undo_SP" name="Cancel trip" isForCompensation="true"/>
    <association id="Assoc_SP" sourceRef="CompensateBoundary_SP" targetRef="Undo_SP" associationDirection="One"/>
    <intermediateThrowEvent id="CompensateThrow_1">
      <incoming>Flow_sp_to_throw</incoming>
      <outgoing>Flow_throw_to_end</outgoing>
      <compensateEventDefinition id="CompensateThrowDef_1"/>
    </intermediateThrowEvent>
    <endEvent id="End_1">
      <incoming>Flow_throw_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_sp" sourceRef="Start_1" targetRef="SubProcess_1"/>
    <sequenceFlow id="Flow_sp_to_throw" sourceRef="SubProcess_1" targetRef="CompensateThrow_1"/>
    <sequenceFlow id="Flow_throw_to_end" sourceRef="CompensateThrow_1" targetRef="End_1"/>
  </process>
</definitions>
