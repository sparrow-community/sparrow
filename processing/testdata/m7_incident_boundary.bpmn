<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_incident_boundary"
             targetNamespace="http://sparrow.example/incident-boundary">
  <process id="Process_incident_boundary" name="M7 Incident Boundary" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_svc</outgoing>
    </startEvent>
    <serviceTask id="ServiceTask_1" name="Work" implementation="work.v1">
      <incoming>Flow_start_to_svc</incoming>
      <outgoing>Flow_svc_to_ok</outgoing>
    </serviceTask>
    <boundaryEvent id="TimerBoundary_1" attachedToRef="ServiceTask_1" cancelActivity="true">
      <outgoing>Flow_boundary_to_timeout</outgoing>
      <timerEventDefinition id="TimerDef_1">
        <timeDuration xsi:type="tFormalExpression">PT0S</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <endEvent id="EndEvent_ok">
      <incoming>Flow_svc_to_ok</incoming>
    </endEvent>
    <endEvent id="EndEvent_timeout">
      <incoming>Flow_boundary_to_timeout</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_svc" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="Flow_svc_to_ok" sourceRef="ServiceTask_1" targetRef="EndEvent_ok"/>
    <sequenceFlow id="Flow_boundary_to_timeout" sourceRef="TimerBoundary_1" targetRef="EndEvent_timeout"/>
  </process>
</definitions>
