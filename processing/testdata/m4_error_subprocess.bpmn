<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_error_subprocess"
             targetNamespace="http://sparrow.example/error-subprocess">
  <error id="Error_inner" errorCode="INNER_FAIL" name="Inner failure"/>
  <process id="Process_error_subprocess" name="M4 Error SubProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_sp</outgoing>
    </startEvent>
    <subProcess id="SubProcess_1" name="Inner">
      <startEvent id="StartEvent_sp">
        <outgoing>Flow_sp_start_to_task</outgoing>
      </startEvent>
      <userTask id="UserTask_sp" name="Inner work">
        <incoming>Flow_sp_start_to_task</incoming>
        <outgoing>Flow_sp_task_to_err</outgoing>
      </userTask>
      <endEvent id="EndEvent_sp_err">
        <incoming>Flow_sp_task_to_err</incoming>
        <errorEventDefinition id="ErrorDef_sp" errorRef="Error_inner"/>
      </endEvent>
      <sequenceFlow id="Flow_sp_start_to_task" sourceRef="StartEvent_sp" targetRef="UserTask_sp"/>
      <sequenceFlow id="Flow_sp_task_to_err" sourceRef="UserTask_sp" targetRef="EndEvent_sp_err"/>
    </subProcess>
    <boundaryEvent id="ErrorBoundary_sp" attachedToRef="SubProcess_1" cancelActivity="true">
      <outgoing>Flow_boundary_to_err</outgoing>
      <errorEventDefinition id="ErrorDef_boundary" errorRef="Error_inner"/>
    </boundaryEvent>
    <endEvent id="EndEvent_ok">
      <incoming>Flow_sp_to_ok</incoming>
    </endEvent>
    <endEvent id="EndEvent_err">
      <incoming>Flow_boundary_to_err</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_sp" sourceRef="StartEvent_1" targetRef="SubProcess_1"/>
    <sequenceFlow id="Flow_sp_to_ok" sourceRef="SubProcess_1" targetRef="EndEvent_ok"/>
    <sequenceFlow id="Flow_boundary_to_err" sourceRef="ErrorBoundary_sp" targetRef="EndEvent_err"/>
  </process>
</definitions>
