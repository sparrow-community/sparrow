<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_multi_msg_dup"
             targetNamespace="http://sparrow.example/multi-msg-dup">
  <message id="Msg_a" name="cancel.a"/>
  <process id="Process_multi_msg_dup" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_task</outgoing>
    </startEvent>
    <userTask id="UserTask_1">
      <incoming>Flow_start_to_task</incoming>
      <outgoing>Flow_task_to_end</outgoing>
    </userTask>
    <boundaryEvent id="MessageBoundary_A" attachedToRef="UserTask_1" cancelActivity="true">
      <outgoing>Flow_a_to_end</outgoing>
      <messageEventDefinition messageRef="Msg_a"/>
    </boundaryEvent>
    <boundaryEvent id="MessageBoundary_A2" attachedToRef="UserTask_1" cancelActivity="true">
      <outgoing>Flow_a2_to_end</outgoing>
      <messageEventDefinition messageRef="Msg_a"/>
    </boundaryEvent>
    <endEvent id="End_ok">
      <incoming>Flow_task_to_end</incoming>
    </endEvent>
    <endEvent id="End_a">
      <incoming>Flow_a_to_end</incoming>
    </endEvent>
    <endEvent id="End_a2">
      <incoming>Flow_a2_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_task" sourceRef="Start_1" targetRef="UserTask_1"/>
    <sequenceFlow id="Flow_task_to_end" sourceRef="UserTask_1" targetRef="End_ok"/>
    <sequenceFlow id="Flow_a_to_end" sourceRef="MessageBoundary_A" targetRef="End_a"/>
    <sequenceFlow id="Flow_a2_to_end" sourceRef="MessageBoundary_A2" targetRef="End_a2"/>
  </process>
</definitions>
