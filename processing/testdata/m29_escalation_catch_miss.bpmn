<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_escalation_catch_miss"
             targetNamespace="http://sparrow.example/escalation-catch-miss">
  <escalation id="Esc_1" name="Escalation 1" escalationCode="ESC_1"/>
  <escalation id="Esc_2" name="Escalation 2" escalationCode="ESC_2"/>
  <process id="Process_escalation_catch_miss" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_fork</outgoing>
    </startEvent>
    <parallelGateway id="Fork_1">
      <incoming>Flow_start_to_fork</incoming>
      <outgoing>Flow_fork_to_catch</outgoing>
      <outgoing>Flow_fork_to_task</outgoing>
    </parallelGateway>
    <intermediateCatchEvent id="Catch_esc">
      <incoming>Flow_fork_to_catch</incoming>
      <outgoing>Flow_catch_to_join</outgoing>
      <escalationEventDefinition escalationRef="Esc_1"/>
    </intermediateCatchEvent>
    <userTask id="Task_1" name="Work">
      <incoming>Flow_fork_to_task</incoming>
      <outgoing>Flow_task_to_throw</outgoing>
    </userTask>
    <intermediateThrowEvent id="Throw_esc">
      <incoming>Flow_task_to_throw</incoming>
      <outgoing>Flow_throw_to_end</outgoing>
      <escalationEventDefinition escalationRef="Esc_2"/>
    </intermediateThrowEvent>
    <endEvent id="End_throw">
      <incoming>Flow_throw_to_end</incoming>
    </endEvent>
    <parallelGateway id="Join_1">
      <incoming>Flow_catch_to_join</incoming>
      <outgoing>Flow_join_to_end</outgoing>
    </parallelGateway>
    <endEvent id="End_catch">
      <incoming>Flow_join_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_fork" sourceRef="Start_1" targetRef="Fork_1"/>
    <sequenceFlow id="Flow_fork_to_catch" sourceRef="Fork_1" targetRef="Catch_esc"/>
    <sequenceFlow id="Flow_fork_to_task" sourceRef="Fork_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_task_to_throw" sourceRef="Task_1" targetRef="Throw_esc"/>
    <sequenceFlow id="Flow_catch_to_join" sourceRef="Catch_esc" targetRef="Join_1"/>
    <sequenceFlow id="Flow_throw_to_end" sourceRef="Throw_esc" targetRef="End_throw"/>
    <sequenceFlow id="Flow_join_to_end" sourceRef="Join_1" targetRef="End_catch"/>
  </process>
</definitions>
