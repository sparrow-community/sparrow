<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_compensate_end"
             targetNamespace="http://sparrow.example/compensate-end">
  <process id="Process_compensate_end" name="M4 Compensate End" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_a</outgoing>
    </startEvent>
    <userTask id="Task_A" name="Book">
      <incoming>Flow_start_to_a</incoming>
      <outgoing>Flow_a_to_end</outgoing>
    </userTask>
    <boundaryEvent id="CompensateBoundary_A" attachedToRef="Task_A" cancelActivity="false">
      <compensateEventDefinition id="CompensateDef_A"/>
    </boundaryEvent>
    <userTask id="Undo_A" name="Cancel Booking" isForCompensation="true"/>
    <association id="Assoc_A" sourceRef="CompensateBoundary_A" targetRef="Undo_A" associationDirection="One"/>
    <endEvent id="CompensateEnd_1">
      <incoming>Flow_a_to_end</incoming>
      <compensateEventDefinition id="CompensateEndDef_1"/>
    </endEvent>
    <sequenceFlow id="Flow_start_to_a" sourceRef="Start_1" targetRef="Task_A"/>
    <sequenceFlow id="Flow_a_to_end" sourceRef="Task_A" targetRef="CompensateEnd_1"/>
  </process>
</definitions>
