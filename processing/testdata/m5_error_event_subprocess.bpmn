<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_error_event_subprocess"
             targetNamespace="http://sparrow.example/error-event-subprocess">
  <error id="Error_e1" errorCode="E1" name="Error E1"/>
  <process id="Process_error_event_subprocess" name="M5 Error Event SubProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_err</outgoing>
    </startEvent>
    <endEvent id="EndEvent_err">
      <incoming>Flow_start_to_err</incoming>
      <errorEventDefinition id="ErrorDef_end" errorRef="Error_e1"/>
    </endEvent>
    <sequenceFlow id="Flow_start_to_err" sourceRef="StartEvent_1" targetRef="EndEvent_err"/>

    <subProcess id="Event_SubProcess_1" name="On E1" triggeredByEvent="true">
      <startEvent id="Start_EventSubProcess_1" isInterrupting="true">
        <outgoing>Flow_event_subprocess_start_to_task</outgoing>
        <errorEventDefinition id="ErrorDef_EventSubProcess_1" errorRef="Error_e1"/>
      </startEvent>
      <userTask id="UserTask_EventSubProcess_1" name="Handle error">
        <incoming>Flow_event_subprocess_start_to_task</incoming>
        <outgoing>Flow_event_subprocess_task_to_end</outgoing>
      </userTask>
      <endEvent id="End_EventSubProcess_1">
        <incoming>Flow_event_subprocess_task_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_event_subprocess_start_to_task" sourceRef="Start_EventSubProcess_1" targetRef="UserTask_EventSubProcess_1"/>
      <sequenceFlow id="Flow_event_subprocess_task_to_end" sourceRef="UserTask_EventSubProcess_1" targetRef="End_EventSubProcess_1"/>
    </subProcess>
  </process>
</definitions>
