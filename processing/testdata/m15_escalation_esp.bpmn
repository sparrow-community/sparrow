<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_escalation_esp"
             targetNamespace="http://sparrow.example/escalation-esp">
  <escalation id="Esc_1" name="Escalation 1" escalationCode="ESC_1"/>
  <process id="Process_escalation_esp" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_end</outgoing>
    </startEvent>
    <endEvent id="End_esc">
      <incoming>Flow_start_to_end</incoming>
      <escalationEventDefinition escalationRef="Esc_1"/>
    </endEvent>
    <sequenceFlow id="Flow_start_to_end" sourceRef="Start_1" targetRef="End_esc"/>

    <subProcess id="Event_SubProcess_1" triggeredByEvent="true">
      <startEvent id="Start_EventSubProcess_1" isInterrupting="true">
        <outgoing>Flow_esp_start_to_task</outgoing>
        <escalationEventDefinition escalationRef="Esc_1"/>
      </startEvent>
      <userTask id="UserTask_EventSubProcess_1">
        <incoming>Flow_esp_start_to_task</incoming>
        <outgoing>Flow_esp_task_to_end</outgoing>
      </userTask>
      <endEvent id="End_EventSubProcess_1">
        <incoming>Flow_esp_task_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_esp_start_to_task" sourceRef="Start_EventSubProcess_1" targetRef="UserTask_EventSubProcess_1"/>
      <sequenceFlow id="Flow_esp_task_to_end" sourceRef="UserTask_EventSubProcess_1" targetRef="End_EventSubProcess_1"/>
    </subProcess>
  </process>
</definitions>
