<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_mi_early"
             targetNamespace="http://sparrow.example/m6">
  <process id="Process_mi_early" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_task</outgoing>
    </startEvent>
    <userTask id="UserTask_mi">
      <incoming>Flow_start_to_task</incoming>
      <outgoing>Flow_task_to_end</outgoing>
      <multiInstanceLoopCharacteristics>
        <loopCardinality xsi:type="tFormalExpression">5</loopCardinality>
        <completionCondition xsi:type="tFormalExpression">${nrOfCompletedInstances >= 2}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <endEvent id="EndEvent_1">
      <incoming>Flow_task_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_task" sourceRef="StartEvent_1" targetRef="UserTask_mi"/>
    <sequenceFlow id="Flow_task_to_end" sourceRef="UserTask_mi" targetRef="EndEvent_1"/>
  </process>
</definitions>
