<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_service"
             targetNamespace="http://sparrow.example/service">
  <process id="Process_service" name="M2 ServiceTask" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_svc</outgoing>
    </startEvent>
    <serviceTask id="ServiceTask_1" name="Work" implementation="work.v1">
      <incoming>Flow_start_to_svc</incoming>
      <outgoing>Flow_svc_to_end</outgoing>
    </serviceTask>
    <endEvent id="EndEvent_1">
      <incoming>Flow_svc_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_svc" sourceRef="StartEvent_1" targetRef="ServiceTask_1"/>
    <sequenceFlow id="Flow_svc_to_end" sourceRef="ServiceTask_1" targetRef="EndEvent_1"/>
  </process>
</definitions>
