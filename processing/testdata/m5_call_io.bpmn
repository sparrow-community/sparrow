<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_call_io"
             targetNamespace="http://sparrow.example/call-io">
  <process id="Process_caller_io" isExecutable="true">
    <startEvent id="Start_caller">
      <outgoing>Flow_s_c</outgoing>
    </startEvent>
    <callActivity id="CallActivity_1" calledElement="Process_called_io">
      <incoming>Flow_s_c</incoming>
      <outgoing>Flow_c_e</outgoing>
      <dataInputAssociation>
        <sourceRef>orderId</sourceRef>
        <targetRef>id</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation>
        <sourceRef>total</sourceRef>
        <targetRef>amount</targetRef>
      </dataOutputAssociation>
    </callActivity>
    <endEvent id="End_caller">
      <incoming>Flow_c_e</incoming>
    </endEvent>
    <sequenceFlow id="Flow_s_c" sourceRef="Start_caller" targetRef="CallActivity_1"/>
    <sequenceFlow id="Flow_c_e" sourceRef="CallActivity_1" targetRef="End_caller"/>
  </process>
  <process id="Process_called_io" isExecutable="false">
    <startEvent id="Start_called">
      <outgoing>Flow_cs_t</outgoing>
    </startEvent>
    <userTask id="Task_called">
      <incoming>Flow_cs_t</incoming>
      <outgoing>Flow_ct_e</outgoing>
    </userTask>
    <endEvent id="End_called">
      <incoming>Flow_ct_e</incoming>
    </endEvent>
    <sequenceFlow id="Flow_cs_t" sourceRef="Start_called" targetRef="Task_called"/>
    <sequenceFlow id="Flow_ct_e" sourceRef="Task_called" targetRef="End_called"/>
  </process>
</definitions>
