<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_message_boundary"
             targetNamespace="http://sparrow.example/message-boundary">
  <message id="message_1" name="order.cancelled"/>
  <process id="Process_message_boundary" name="M2 Message Boundary" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_start_to_task</outgoing>
    </startEvent>
    <userTask id="UserTask_1" name="Work">
      <incoming>Flow_start_to_task</incoming>
      <outgoing>Flow_task_to_ok</outgoing>
    </userTask>
    <boundaryEvent id="MessageBoundary_1" attachedToRef="UserTask_1" cancelActivity="true">
      <outgoing>Flow_boundary_to_msg</outgoing>
      <messageEventDefinition id="MsgDef_1" messageRef="message_1"/>
    </boundaryEvent>
    <endEvent id="EndEvent_ok">
      <incoming>Flow_task_to_ok</incoming>
    </endEvent>
    <endEvent id="EndEvent_msg">
      <incoming>Flow_boundary_to_msg</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_task" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <sequenceFlow id="Flow_task_to_ok" sourceRef="UserTask_1" targetRef="EndEvent_ok"/>
    <sequenceFlow id="Flow_boundary_to_msg" sourceRef="MessageBoundary_1" targetRef="EndEvent_msg"/>
  </process>
</definitions>
