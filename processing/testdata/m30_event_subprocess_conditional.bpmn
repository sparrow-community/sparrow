<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_esp_conditional"
             targetNamespace="http://sparrow.example/esp-conditional">
  <process id="Process_esp_conditional" name="M30 Event SubProcess Conditional" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_task</outgoing>
    </startEvent>
    <userTask id="UserTask_1" name="Work">
      <incoming>Flow_start_to_task</incoming>
      <outgoing>Flow_task_to_end</outgoing>
    </userTask>
    <endEvent id="End_1">
      <incoming>Flow_task_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_task" sourceRef="Start_1" targetRef="UserTask_1"/>
    <sequenceFlow id="Flow_task_to_end" sourceRef="UserTask_1" targetRef="End_1"/>

    <subProcess id="Event_SubProcess_1" name="On Ready" triggeredByEvent="true">
      <startEvent id="Start_ESP" isInterrupting="true">
        <outgoing>Flow_esp_start_to_end</outgoing>
        <conditionalEventDefinition id="CondDef_ESP">
          <condition xsi:type="tFormalExpression">${ready == true}</condition>
        </conditionalEventDefinition>
      </startEvent>
      <endEvent id="End_ESP">
        <incoming>Flow_esp_start_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_esp_start_to_end" sourceRef="Start_ESP" targetRef="End_ESP"/>
    </subProcess>
  </process>
</definitions>
