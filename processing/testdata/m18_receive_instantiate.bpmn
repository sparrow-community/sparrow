<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_receive_inst"
             targetNamespace="http://sparrow.example/receive-inst">
  <message id="message_1" name="order.confirmed"/>
  <process id="Process_receive_inst" name="Instantiate Receive" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <receiveTask id="ReceiveTask_1" name="Start" messageRef="message_1" instantiate="true">
      <incoming>Flow_1</incoming>
    </receiveTask>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ReceiveTask_1"/>
  </process>
</definitions>
