<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_compensate_esp_nested"
             targetNamespace="http://sparrow.example/compensate-esp-nested">
  <process id="Process_compensate_esp_nested" name="M27 Compensate Event Sub-Process Nested" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_sp</outgoing>
    </startEvent>
    <subProcess id="SubProcess_1" name="Make Booking">
      <incoming>Flow_start_to_sp</incoming>
      <outgoing>Flow_sp_to_throw</outgoing>
      <startEvent id="Start_sp">
        <outgoing>Flow_sp_start_to_a</outgoing>
      </startEvent>
      <userTask id="Task_A" name="Book Flight">
        <incoming>Flow_sp_start_to_a</incoming>
        <outgoing>Flow_a_to_b</outgoing>
      </userTask>
      <boundaryEvent id="CompensateBoundary_A" attachedToRef="Task_A" cancelActivity="false">
        <compensateEventDefinition id="CompensateDef_A"/>
      </boundaryEvent>
      <userTask id="Undo_A" name="Cancel Flight" isForCompensation="true"/>
      <association id="Assoc_A" sourceRef="CompensateBoundary_A" targetRef="Undo_A" associationDirection="One"/>
      <userTask id="Task_B" name="Book Hotel">
        <incoming>Flow_a_to_b</incoming>
        <outgoing>Flow_b_to_end</outgoing>
      </userTask>
      <boundaryEvent id="CompensateBoundary_B" attachedToRef="Task_B" cancelActivity="false">
        <compensateEventDefinition id="CompensateDef_B"/>
      </boundaryEvent>
      <userTask id="Undo_B" name="Cancel Hotel" isForCompensation="true"/>
      <association id="Assoc_B" sourceRef="CompensateBoundary_B" targetRef="Undo_B" associationDirection="One"/>
      <endEvent id="End_sp">
        <incoming>Flow_b_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_sp_start_to_a" sourceRef="Start_sp" targetRef="Task_A"/>
      <sequenceFlow id="Flow_a_to_b" sourceRef="Task_A" targetRef="Task_B"/>
      <sequenceFlow id="Flow_b_to_end" sourceRef="Task_B" targetRef="End_sp"/>
      <subProcess id="Event_SubProcess_Compensate" triggeredByEvent="true">
        <startEvent id="Start_Compensate" isInterrupting="false">
          <outgoing>Flow_esp_start_to_inner_throw</outgoing>
          <compensateEventDefinition id="CompensateStartDef_1"/>
        </startEvent>
        <intermediateThrowEvent id="InnerCompensateThrow">
          <incoming>Flow_esp_start_to_inner_throw</incoming>
          <outgoing>Flow_esp_throw_to_end</outgoing>
          <compensateEventDefinition id="InnerCompensateThrowDef"/>
        </intermediateThrowEvent>
        <endEvent id="End_ESP">
          <incoming>Flow_esp_throw_to_end</incoming>
        </endEvent>
        <sequenceFlow id="Flow_esp_start_to_inner_throw" sourceRef="Start_Compensate" targetRef="InnerCompensateThrow"/>
        <sequenceFlow id="Flow_esp_throw_to_end" sourceRef="InnerCompensateThrow" targetRef="End_ESP"/>
      </subProcess>
    </subProcess>
    <intermediateThrowEvent id="CompensateThrow_1">
      <incoming>Flow_sp_to_throw</incoming>
      <outgoing>Flow_throw_to_end</outgoing>
      <compensateEventDefinition id="CompensateThrowDef_1" activityRef="SubProcess_1"/>
    </intermediateThrowEvent>
    <endEvent id="End_1">
      <incoming>Flow_throw_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_sp" sourceRef="Start_1" targetRef="SubProcess_1"/>
    <sequenceFlow id="Flow_sp_to_throw" sourceRef="SubProcess_1" targetRef="CompensateThrow_1"/>
    <sequenceFlow id="Flow_throw_to_end" sourceRef="CompensateThrow_1" targetRef="End_1"/>
  </process>
</definitions>
