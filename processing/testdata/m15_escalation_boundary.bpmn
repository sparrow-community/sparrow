<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_escalation_boundary"
             targetNamespace="http://sparrow.example/escalation-boundary">
  <escalation id="Esc_1" name="Escalation 1" escalationCode="ESC_1"/>
  <process id="Process_escalation_boundary" isExecutable="true">
    <startEvent id="Start_1">
      <outgoing>Flow_start_to_sp</outgoing>
    </startEvent>
    <subProcess id="SubProcess_1">
      <startEvent id="Start_sp">
        <outgoing>Flow_sp_start_to_throw</outgoing>
      </startEvent>
      <intermediateThrowEvent id="Throw_esc">
        <incoming>Flow_sp_start_to_throw</incoming>
        <outgoing>Flow_sp_throw_to_end</outgoing>
        <escalationEventDefinition escalationRef="Esc_1"/>
      </intermediateThrowEvent>
      <endEvent id="End_sp">
        <incoming>Flow_sp_throw_to_end</incoming>
      </endEvent>
      <sequenceFlow id="Flow_sp_start_to_throw" sourceRef="Start_sp" targetRef="Throw_esc"/>
      <sequenceFlow id="Flow_sp_throw_to_end" sourceRef="Throw_esc" targetRef="End_sp"/>
    </subProcess>
    <boundaryEvent id="EscalationBoundary_1" attachedToRef="SubProcess_1" cancelActivity="true">
      <outgoing>Flow_boundary_to_end</outgoing>
      <escalationEventDefinition escalationRef="Esc_1"/>
    </boundaryEvent>
    <endEvent id="End_ok">
      <incoming>Flow_sp_to_ok</incoming>
    </endEvent>
    <endEvent id="End_esc">
      <incoming>Flow_boundary_to_end</incoming>
    </endEvent>
    <sequenceFlow id="Flow_start_to_sp" sourceRef="Start_1" targetRef="SubProcess_1"/>
    <sequenceFlow id="Flow_sp_to_ok" sourceRef="SubProcess_1" targetRef="End_ok"/>
    <sequenceFlow id="Flow_boundary_to_end" sourceRef="EscalationBoundary_1" targetRef="End_esc"/>
  </process>
</definitions>
